{
  "name": "project-02-private-chat-app",
  "version": "1.0.0",
  "description": "Real-Time Chat App with React, Node.js, Express, Socket.IO, and MongoDB",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "install-all": "npm install --prefix server && npm install --prefix client",
    "server": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client"
  },
  "keywords": [
    "chat",
    "socket.io",
    "react",
    "mongodb",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
